# AI 模型配置（支持 OpenAI 兼容接口）
# 至少配置一个模型

# 默认模型
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-api-key-here
AI_MODEL_NAME=gpt-4o

# 备选模型（可选，可在前端切换）
# AI_BASE_URL_2=https://api.deepseek.com/v1
# AI_API_KEY_2=sk-your-deepseek-key
# AI_MODEL_NAME_2=deepseek-chat

# 数据库路径（SQLite 文件路径）
DATABASE_URL=sqlite+aiosqlite:///./screenplay.db

# 服务配置
HOST=0.0.0.0
PORT=8000
